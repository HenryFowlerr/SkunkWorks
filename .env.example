# Browser-safe Supabase project values. Use an active SkunkWorks development project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only provider credentials. Never use NEXT_PUBLIC_ for these.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Server-side model routing. Astra is limited to the high-detail pitch
# capability scan and knowledge-base draft. Luna handles generation, floor
# questions, engineer reply drafts, and issue triage.
OPENAI_INITIAL_MODEL=gpt-6-astra
OPENAI_FLOOR_MODEL=gpt-6-luna
# Legacy alias for OPENAI_INITIAL_MODEL only. Do not set this in new deployments.
OPENAI_MODEL=
# Optional integer in milliseconds; defaults to 25000 and accepts 1000–50000.
OPENAI_TIMEOUT_MS=

# Live Luna safety controls for phone questions and engineer report drafts.
# Default: 5 requests per authenticated user + part + action every 10 minutes.
# Values cannot exceed 10 requests or a 60 minute window in the app.
FLOOR_AI_MAX_REQUESTS_PER_WINDOW=
FLOOR_AI_REQUEST_WINDOW_MS=

# Pitch-demo safety controls. Invalid values fall back to conservative defaults.
# Default: 2 requests per authenticated user + job + action every 10 minutes.
# Values cannot exceed 3 requests or a 60 minute window in the app.
PITCH_AI_MAX_REQUESTS_PER_WINDOW=
PITCH_AI_REQUEST_WINDOW_MS=
# Output ceilings are hard-bounded by the app. Leave blank for 1200 / 1800 / 900 / 750.
# Valid ranges: capability 256–1600, knowledge base 512–2400, triage 256–1200, phone preview 256–1000.
PITCH_AI_CAPABILITY_MAX_OUTPUT_TOKENS=
PITCH_AI_KNOWLEDGE_BASE_MAX_OUTPUT_TOKENS=
PITCH_AI_TRIAGE_MAX_OUTPUT_TOKENS=
PITCH_AI_PREVIEW_QUESTION_MAX_OUTPUT_TOKENS=
